{
  "name": "goletter/hyperf-2fa",
  "description": "Google Authenticator (TOTP) 2FA for Hyperf: bind user, per-module verify, idle re-challenge",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "goletter",
      "email": "goletter@outlook.com"
    }
  ],
  "keywords": [
    "php",
    "hyperf",
    "2fa",
    "totp",
    "google-authenticator",
    "otp"
  ],
  "require": {
    "php": ">=8.1",
    "hyperf/config": "~3.1.0",
    "hyperf/context": "~3.1.0",
    "hyperf/contract": "~3.1.0",
    "hyperf/di": "~3.1.0",
    "hyperf/http-server": "~3.1.0",
    "hyperf/redis": "~3.1.0",
    "hyperf/support": "~3.1.0",
    "pragmarx/google2fa": "^8.0 || ^9.0",
    "psr/http-message": "^1.0 || ^2.0",
    "psr/http-server-middleware": "^1.0"
  },
  "suggest": {
    "pragmarx/google2fa-qrcode": "Generate inline QR code images for binding"
  },
  "autoload": {
    "psr-4": {
      "Goletter\\TwoFa\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Goletter\\TwoFa\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "hyperf": {
      "config": "Goletter\\TwoFa\\ConfigProvider"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit 300M -l 0 ./src",
    "cs-fix": "php-cs-fixer fix $1"
  }
}
